  ~openConfig()
  ~openAccessibility() 
}
class "Name" as Notification.Name << (X, Orchid) extension >> { 
  ~{static} hijackActivity : NSNotification.Name 
}
VoiceProvider <|.. InputMethodProvider
VoiceProvider <|.. AppProvider

