{
  "version": 1,
  "lineLength": 140,
  "indentation": {
    "spaces": 4
  },
  "tabWidth": 4,
  "rules": {
    "AlwaysUseLowerCamelCase": false,
    "DoNotUseSemicolons": false,
    "OneVariableDeclarationPerLine": false,
    "NeverForceUnwrap": true,
    "NeverUseImplicitlyUnwrappedOptionals": true
  }
}
